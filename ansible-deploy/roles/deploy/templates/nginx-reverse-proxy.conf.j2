# Реверс-прокирование {{ fqdn }} -> контейнер {{ container_name }} (127.0.0.1:{{ host_port }})
upstream {{ project_name }}_backend {
    server 127.0.0.1:{{ host_port }};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ fqdn }};

    location /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ fqdn }};

    ssl_certificate     {{ fullchain_path }};
    ssl_certificate_key {{ privkey_path }};
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/{{ project_name }}.access.log;
    error_log  /var/log/nginx/{{ project_name }}.error.log;

    location / {
        proxy_pass http://{{ project_name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 120s;
    }
}
